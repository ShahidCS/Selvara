# Copy to .env.local. Nothing here is a secret; there are no secrets in this repo. Values marked SECRET are set in the hosting
# provider's environment settings (or a secrets manager) only, never committed. Setup steps: docs/guides/SUPABASE.md.

# ---- Browser (public) ----
# Base URL of the GRC API. Leave empty to use the in-memory mock services (default).
NEXT_PUBLIC_API_BASE_URL=
# "mock" returns seeded synthetic data from src/data; "http" calls NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock

# ---- Server: required for the production API (without them /api answers 503) ----
SITE_URL=https://app.example.test
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# SECRET
SUPABASE_SERVICE_ROLE_KEY=
# SECRET: postgres connection string for the least-privilege role selvara_app (not the postgres owner)
DATABASE_URL=
DATABASE_CA_CERT=
EVIDENCE_BUCKET=evidence
# SECRET: at least 32 random characters (seals sign-in tickets, keys HMACs)
SERVER_SECRET=

# ---- Server: recommended ----
# Keys the alias match of requests to join (EDGE-20). Set it once and keep it: changing it forgets earlier rejections. Without it a key
# derived from SERVER_SECRET is used (rotating SERVER_SECRET then forgets them).
# SECRET: at least 32 random characters
MATCH_KEY_SECRET=

# ---- Server: optional features (each stays off while its values are empty) ----
MAIL_PROVIDER=
MAIL_FROM=
# SECRET
MAIL_API_KEY=
SUPPORT_INBOX_EMAIL=
# SECRET
ANTHROPIC_API_KEY=
SELVARA_AI_MODEL=
# SECRET (both)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# SECRET (both)
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
AWS_INTEGRATION_PRINCIPAL_ARN=
AWS_INTEGRATION_ACCESS_KEY_ID=
# SECRET
AWS_INTEGRATION_SECRET_ACCESS_KEY=
ENTRA_CLIENT_ID=
# SECRET
ENTRA_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
# SECRET
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_SA_EMAIL=
GOOGLE_SA_CLIENT_ID=
# SECRET
GOOGLE_SA_PRIVATE_KEY=
