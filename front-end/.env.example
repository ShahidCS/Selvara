# Copy to .env.local. Nothing here is a secret; there are no secrets in this repo.
# Base URL of the GRC API. Leave empty to use the in-memory mock services (default).
NEXT_PUBLIC_API_BASE_URL=
# "mock" returns seeded synthetic data from src/data; "http" calls NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock
